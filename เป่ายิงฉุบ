import random

print("✨ เกมเป่ายิ้งฉุบ ✨")
print("กติกา: พิมพ์ ค้อน, กรรไกร หรือ กระดาษ เพื่อเล่น\n")

# ตัวเลือกในเกม
ตัวเลือก = ["ค้อน", "กรรไกร", "กระดาษ"]

while True:
    # 1. รับค่าจากผู้เล่น
    ผู้เล่น = input("คุณเลือกอะไร? (หรือพิมพ์ 'ออก' เพื่อเลิกเล่น): ").strip()

    # ตรวจสอบว่าต้องการเลิกเล่นไหม
    if ผู้เล่น == "ออก":
        print("ขอบคุณที่ร่วมสนุกครับ! บายๆ 👋")
        break

    # ตรวจสอบว่าผู้เล่นพิมพ์ตัวเลือกถูกต้องไหม
    if ผู้เล่น not in ตัวเลือก:
        print("❌ พิมพ์ผิดแล้ว! กรุณาพิมพ์แค่ ค้อน, กรรไกร หรือ กระดาษ เท่านั้นนะ\n")
        continue

    # 2. ให้คอมพิวเตอร์สุ่มเลือก
    คอมพิวเตอร์ = random.choice(ตัวเลือก)
    print(f"🤖 คอมพิวเตอร์เลือก: {คอมพิวเตอร์}")

    # 3. ตรวจสอบผลแพ้ชนะ
    if ผู้เล่น == คอมพิวเตอร์:
        print("🤝 เสมอกันซะงั้น! เอาใหม่ๆ")
    elif (ผู้เล่น == "ค้อน" and คอมพิวเตอร์ == "กรรไกร") or \
         (ผู้เล่น == "กรรไกร" and คอมพิวเตอร์ == "กระดาษ") or \
         (ผู้เล่น == "กระดาษ" and คอมพิวเตอร์ == "ค้อน"):
        print("🎉 ยินดีด้วย คุณชนะแล้ว! 🏆")
    else:
        print("ดวงไม่ดีเลย คุณแพ้คอมพิวเตอร์นะ 😢")
        
    print("-" * 30 + "\n")
